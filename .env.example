# ---------------------------------------------------------------
# CHẠY NHANH — không cần máy chủ nào
# ---------------------------------------------------------------
# Để TRỐNG cả ba biến dưới đây là xong: app chạy Local Mode, tài khoản và tiến
# độ lưu trong AsyncStorage của máy. Đăng ký, đăng nhập, mã PIN, tính giờ chơi
# game đều hoạt động bình thường, chỉ là không đồng bộ sang máy khác.
#
# EXPO_PUBLIC_PROGRESS_API_URL=https://api.example.com
# EXPO_PUBLIC_TURSO_DATABASE_URL=
# EXPO_PUBLIC_TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------
# Máy chủ đồng bộ (Vercel serverless + Turso)
# ---------------------------------------------------------------
# App KHÔNG giữ token Turso và KHÔNG tự chạy SQL. App chỉ gọi tới
# api/auth và api/progress; token database nằm trong biến môi trường
# của Vercel.
#
# Đặt bằng domain đã deploy. Bản web cùng origin nên để trống cũng chạy.
EXPO_PUBLIC_PROGRESS_API_URL=https://your-app.vercel.app

# ---------------------------------------------------------------
# Biến chỉ đặt trên VERCEL (không có tiền tố EXPO_PUBLIC_)
# ---------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=<turso db tokens create <db>>
# AUTH_SECRET=<chuỗi ngẫu nhiên >= 16 ký tự, dùng để ký session token>

# ---------------------------------------------------------------
# Supabase (tuỳ chọn, không còn dùng cho đăng nhập)
# ---------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# CẢNH BÁO — đừng bật trên bản public:
# Hai biến này nhúng token Turso vào bundle công khai, nghĩa là ai cũng
# đọc được bảng users (kể cả password_hash) và xoá sạch được database.
# EXPO_PUBLIC_TURSO_DATABASE_URL=
# EXPO_PUBLIC_TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------
# Đường dẫn tải bản cập nhật APK (nút trong màn hình Cài đặt)
# ---------------------------------------------------------------
# Trỏ vào /api/download-apk trên Vercel chứ không trỏ thẳng vào GitHub: đường
# dẫn nằm trong APK đã cài thì không sửa được nữa, nên phải đi qua một lớp
# chuyển hướng để sau này đổi nguồn tải mà máy cũ vẫn tải được bản mới.
EXPO_PUBLIC_APK_DOWNLOAD_URL=https://<domain>.vercel.app/api/download-apk

# Nguồn kiểm tra cập nhật. Để trống thì app tự dùng
# <PROGRESS_API_URL>/api/check-version (đọc trực tiếp GitHub Releases).
# EXPO_PUBLIC_UPDATE_SERVER_URL=

# ---------------------------------------------------------------
# Xem thử hộp thoại cập nhật trong lúc phát triển
# ---------------------------------------------------------------
# Chế độ dev không cập nhật ngầm được (Metro đã lo việc nạp lại mã), nên bình
# thường hộp thoại không hiện. Đặt =1 rồi chạy `npx expo start -c` để xem thử
# giao diện hộp thoại; nút "Cập nhật ngay" sẽ chỉ giả lập chứ không tải gì.
# EXPO_PUBLIC_OTA_DEMO=1
