# ---------------------------------------------------------------
# Máy chủ đồng bộ (Vercel serverless + Turso)
# ---------------------------------------------------------------
# App KHÔNG giữ token Turso và KHÔNG tự chạy SQL. App chỉ gọi tới
# api/auth và api/progress; token database nằm trong biến môi trường
# của Vercel.
#
# Đặt bằng domain đã deploy. Bản web cùng origin nên để trống cũng chạy.
EXPO_PUBLIC_PROGRESS_API_URL=https://your-app.vercel.app

# ---------------------------------------------------------------
# Biến chỉ đặt trên VERCEL (không có tiền tố EXPO_PUBLIC_)
# ---------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=<turso db tokens create <db>>
# AUTH_SECRET=<chuỗi ngẫu nhiên >= 16 ký tự, dùng để ký session token>

# ---------------------------------------------------------------
# Supabase (tuỳ chọn, không còn dùng cho đăng nhập)
# ---------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# CẢNH BÁO — đừng bật trên bản public:
# Hai biến này nhúng token Turso vào bundle công khai, nghĩa là ai cũng
# đọc được bảng users (kể cả password_hash) và xoá sạch được database.
# EXPO_PUBLIC_TURSO_DATABASE_URL=
# EXPO_PUBLIC_TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------
# Đường dẫn tải bản cập nhật APK (nút trong màn hình Cài đặt)
# ---------------------------------------------------------------
EXPO_PUBLIC_APK_DOWNLOAD_URL=https://github.com/<user>/<repo>/releases/latest

# Nguồn kiểm tra cập nhật. Để trống thì app tự dùng <PROGRESS_API_URL>/api/version
# (bảng app_version trên Turso).
# EXPO_PUBLIC_UPDATE_SERVER_URL=
